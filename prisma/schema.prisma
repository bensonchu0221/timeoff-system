// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PartOfDay {
  ALL_DAY
  MORNING
  AFTERNOON
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  // 中文姓名（顯示用，可選；OAuth 帶入的 name 通常是英文/暱稱）
  chineseName    String?
  emailVerified  DateTime?
  image          String?
  role           Role      @default(EMPLOYEE)
  // 部門：外鍵指向 Department 表；管理透過 /admin/departments 後台
  departmentId   String
  department     Department @relation("UserDepartment", fields: [departmentId], references: [id])
  hireDate       DateTime?
  gender         Gender    @default(FEMALE)
  // null = 在職；有值代表「離職日」，自該日起視為離職，所有列表與登入皆排除
  terminatedDate DateTime?

  // 兩階段審核：終審者（Boss）標記。全公司唯一一人為 true（目前 = Connie）。
  // 與 role 權限脫鉤：第一關通過後，需二審的假單一律送交此人終審。
  isFinalApprover Boolean  @default(false)

  // 特休 Opening Balance（資料遷移用）
  // 兩欄同存或同空，由 application code 保證 invariant
  // openingBalance: openingAt 那一刻「應有的累計可請特休」（已含歷史所有 grant/usage 抵銷）
  // openingAt: 切換日；getUserLeaveBalance 之後的 used/pending 也從此切（startDate >= openingAt 才算）
  annualLeaveOpeningBalance Float?
  annualLeaveOpeningAt      DateTime?
  // opening 算式的兩個參數（HR 手動填入，與 balance 同存同空）
  // B = 個人特休基準天數（公司政策或 HR 議定值）
  // R = 切換前 2025 年未休天數
  annualLeaveOpeningB       Float?
  annualLeaveOpeningR       Float?
  // iCal 訂閱簽章 token；首次需要時 lazy 產生，admin 可重設以撤銷舊 URL
  calendarToken  String?

  // LINE 綁定相關
  // lineUserId：LINE 平台的使用者 ID（U 開頭），唯一；綁定後寫入，解綁時清空
  lineUserId        String?   @unique
  // lineBindingCode：員工到 /settings 頁產生的一次性綁定碼，傳給 Bot 後完成綁定即清空
  lineBindingCode   String?   @unique
  // 綁定碼有效期限（30 分鐘），過期需重新產生
  lineBindingExpiry DateTime?
  // 完成綁定的時間，方便除錯與稽核
  lineBoundAt       DateTime?
  // 各類 LINE 通知個別開關，JSON 結構，null 視為全 true
  // 例：{ applicationToManager: true, reviewResult: true, departmentLeave: true, dailyPending: true, dailyRoster: true }
  lineNotifyPrefs   Json?

  // NextAuth
  accounts       Account[]
  sessions       Session[]

  // Self-relation for manager-employee hierarchy
  managerId      String?
  manager        User?     @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates   User[]    @relation("ManagerToEmployee")

  // Leaves and Quotas
  leaveRequests  LeaveRequest[]     @relation("UserLeaveRequests")
  approvedLeaves LeaveRequest[]     @relation("ApproverLeaveRequests")
  // 兩階段審核：作為二審者（Boss）負責終審的假單
  secondApprovedLeaves LeaveRequest[] @relation("SecondApproverLeaveRequests")
  backupRequests LeaveRequest[]     @relation("BackupLeaveRequests")
  leaveBalances  UserLeaveBalance[]
  auditLogs      AuditLog[]         @relation("AuditActor")

  // HR 手動調整（曆年制特休：補發 / 扣除）
  leaveAdjustments    LeaveAdjustment[] @relation("UserLeaveAdjustments")
  createdAdjustments  LeaveAdjustment[] @relation("CreatedLeaveAdjustments")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// 部門：取代 User.department 自由文字欄位，提供 admin 後台 CRUD、排序、停用
// 與 User 透過 departmentId 外鍵關聯；第 2 階段後 User.departmentId NOT NULL
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  users     User[]   @relation("UserDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, name])
  @@index([isActive])
}

model LeaveType {
  id             String    @id @default(uuid())
  name           String    @unique // e.g., "特休", "病假", "事假"
  defaultDays    Float     @default(0) // Default quota (e.g., 14 for Personal leave)
  isPaid         Boolean   @default(true)
  isActive       Boolean   @default(true) // For soft delete
  // 是否需要上傳證明文件（例：婚假、喪假）；事後補件也允許，僅在 UI 與後端做提示/驗證
  requireProof   Boolean   @default(false)

  // Relations
  requests       LeaveRequest[]
  balances       UserLeaveBalance[]
  adjustments    LeaveAdjustment[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UserLeaveBalance {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  year           Int       // The year this balance applies to
  totalQuota     Float     // The total quota for this year (can be overridden per user)
  
  user           User      @relation(fields: [userId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LeaveRequest {
  id             String      @id @default(uuid())
  userId         String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  partOfDay      PartOfDay   @default(ALL_DAY)
  durationDays   Float       // Calculated days, excluding holidays/weekends
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  // 第一關（主管）審核時填寫的訊息（駁回理由、核准備註）；員工 Dashboard 與通知信都會帶
  reviewMessage  String?     @db.Text

  // 第一關審核者（主管）
  approverId     String?
  approver       User?       @relation("ApproverLeaveRequests", fields: [approverId], references: [id])

  // 兩階段審核：第二關終審者（Boss）。null = 此單不需二審（單階段，主管核准即最終）。
  secondApproverId String?
  secondApprover   User?     @relation("SecondApproverLeaveRequests", fields: [secondApproverId], references: [id])
  // 第一關通過時間；非 null 代表「已過一審、目前等二審」，用來推導階段（不另設 enum）
  firstApprovedAt  DateTime?
  // 第二關（Boss）審核留言（駁回理由 / 核准備註）
  secondReviewMessage String? @db.Text

  // 代理人（選填）：員工請假期間請該人協助；有填則通知該代理人
  backupId       String?
  backup         User?       @relation("BackupLeaveRequests", fields: [backupId], references: [id])

  // 24 小時未審核升級用：當 cron 把 pending 單升級給 admin 後寫入時間，避免重複升級
  escalatedAt    DateTime?

  user           User        @relation("UserLeaveRequests", fields: [userId], references: [id])
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])

  // 證明文件（婚假/喪假等需上傳；事後補件也允許）
  attachments    LeaveAttachment[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// 請假證明文件：實體檔案放 GCS gs://popinpoc1-internal-tool/timeoff/leave-proofs/...
// 物件命名規則：timeoff/leave-proofs/{userId}/{leaveRequestId}/{uuid}.{ext}
// 刪除 LeaveRequest 時連同刪除 row（檔案另由 server-side 刪 GCS，避免孤兒物件）
model LeaveAttachment {
  id             String       @id @default(uuid())
  leaveRequestId String
  // GCS 物件完整路徑（不含 bucket），例：timeoff/leave-proofs/uid/rid/xxx.jpg
  objectPath     String       @unique
  // 顯示用原始檔名（使用者上傳時的檔名）
  originalName   String
  mimeType       String       // image/jpeg, image/png, image/webp, application/pdf
  sizeBytes      Int
  // 通常等於 leaveRequest.userId；保留欄位以利日後 HR 代為上傳
  uploadedById   String

  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([leaveRequestId])
}

// HR 手動調整特休（曆年制下，獨立於主計算邏輯之外的補發 / 扣除）
// effectiveAt 之前 balance 不含此調整；員工從 effectiveAt 當天起可動用該天數
model LeaveAdjustment {
  id          String   @id @default(uuid())
  userId      String
  leaveTypeId String
  effectiveAt DateTime // 生效日（UTC midnight）
  amount      Float    // 正=補發、負=扣除（0.5 倍數）
  reason      String   @db.Text // 必填，HR 操作備註

  createdById String   // 操作 HR 的 user id

  user      User      @relation("UserLeaveAdjustments", fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  createdBy User      @relation("CreatedLeaveAdjustments", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, leaveTypeId, effectiveAt])
}

model Holiday {
  id             String    @id @default(uuid())
  date           DateTime  @unique
  name           String
  isWorkDay      Boolean   @default(false) // true if it's a make-up work day on a weekend

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ------------------------------
// NextAuth / Auth.js Models
// ------------------------------

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model FAQ {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 稽核日誌：所有寫操作（核准、駁回、撤銷、改員工資料、改額度等）都會被記錄。
// 採非級聯設計（onDelete 預設 Restrict），避免歷史紀錄因 user 被誤刪而消失。
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String   // LEAVE_APPROVE / LEAVE_REJECT / LEAVE_CANCEL / LEAVE_UPDATE / USER_UPDATE_ROLE / USER_TERMINATE / BALANCE_UPDATE 等
  targetType String   // LeaveRequest / User / LeaveType / UserLeaveBalance / Holiday
  targetId   String
  payload    Json?    // 改動前後值或補充訊息
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
