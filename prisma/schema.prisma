// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PartOfDay {
  ALL_DAY
  MORNING
  AFTERNOON
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  role           Role      @default(EMPLOYEE)
  department     String?
  hireDate       DateTime?
  gender         Gender    @default(FEMALE)
  // null = 在職；有值代表「離職日」，自該日起視為離職，所有列表與登入皆排除
  terminatedDate DateTime?
  // iCal 訂閱簽章 token；首次需要時 lazy 產生，admin 可重設以撤銷舊 URL
  calendarToken  String?

  // LINE 綁定相關
  // lineUserId：LINE 平台的使用者 ID（U 開頭），唯一；綁定後寫入，解綁時清空
  lineUserId        String?   @unique
  // lineBindingCode：員工到 /settings 頁產生的一次性綁定碼，傳給 Bot 後完成綁定即清空
  lineBindingCode   String?   @unique
  // 綁定碼有效期限（30 分鐘），過期需重新產生
  lineBindingExpiry DateTime?
  // 完成綁定的時間，方便除錯與稽核
  lineBoundAt       DateTime?
  // 各類 LINE 通知個別開關，JSON 結構，null 視為全 true
  // 例：{ applicationToManager: true, reviewResult: true, departmentLeave: true, dailyPending: true, dailyRoster: true }
  lineNotifyPrefs   Json?

  // NextAuth
  accounts       Account[]
  sessions       Session[]

  // Self-relation for manager-employee hierarchy
  managerId      String?
  manager        User?     @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates   User[]    @relation("ManagerToEmployee")

  // Leaves and Quotas
  leaveRequests  LeaveRequest[]     @relation("UserLeaveRequests")
  approvedLeaves LeaveRequest[]     @relation("ApproverLeaveRequests")
  backupRequests LeaveRequest[]     @relation("BackupLeaveRequests")
  leaveBalances  UserLeaveBalance[]
  auditLogs      AuditLog[]         @relation("AuditActor")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LeaveType {
  id             String    @id @default(uuid())
  name           String    @unique // e.g., "特休", "病假", "事假"
  defaultDays    Float     @default(0) // Default quota (e.g., 14 for Personal leave)
  isPaid         Boolean   @default(true)
  isActive       Boolean   @default(true) // For soft delete
  
  // Relations
  requests       LeaveRequest[]
  balances       UserLeaveBalance[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model UserLeaveBalance {
  id             String    @id @default(uuid())
  userId         String
  leaveTypeId    String
  year           Int       // The year this balance applies to
  totalQuota     Float     // The total quota for this year (can be overridden per user)
  
  user           User      @relation(fields: [userId], references: [id])
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LeaveRequest {
  id             String      @id @default(uuid())
  userId         String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  partOfDay      PartOfDay   @default(ALL_DAY)
  durationDays   Float       // Calculated days, excluding holidays/weekends
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  // 主管在審核時填寫的訊息（駁回理由、核准備註）；員工 Dashboard 與通知信都會帶
  reviewMessage  String?     @db.Text

  approverId     String?
  approver       User?       @relation("ApproverLeaveRequests", fields: [approverId], references: [id])

  // 代理人（選填）：員工請假期間請該人協助；有填則通知該代理人
  backupId       String?
  backup         User?       @relation("BackupLeaveRequests", fields: [backupId], references: [id])

  // 24 小時未審核升級用：當 cron 把 pending 單升級給 admin 後寫入時間，避免重複升級
  escalatedAt    DateTime?

  user           User        @relation("UserLeaveRequests", fields: [userId], references: [id])
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Holiday {
  id             String    @id @default(uuid())
  date           DateTime  @unique
  name           String
  isWorkDay      Boolean   @default(false) // true if it's a make-up work day on a weekend

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ------------------------------
// NextAuth / Auth.js Models
// ------------------------------

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model FAQ {
  id        String   @id @default(uuid())
  question  String   @db.Text
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 稽核日誌：所有寫操作（核准、駁回、撤銷、改員工資料、改額度等）都會被記錄。
// 採非級聯設計（onDelete 預設 Restrict），避免歷史紀錄因 user 被誤刪而消失。
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String   // LEAVE_APPROVE / LEAVE_REJECT / LEAVE_CANCEL / LEAVE_UPDATE / USER_UPDATE_ROLE / USER_TERMINATE / BALANCE_UPDATE 等
  targetType String   // LeaveRequest / User / LeaveType / UserLeaveBalance / Holiday
  targetId   String
  payload    Json?    // 改動前後值或補充訊息
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
