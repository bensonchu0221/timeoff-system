# 本檔案列出所有環境變數的「key」，不含 value，可安全 commit 進 git。
# 部署時的真實值在 Cloud Run env vars 上（見 DEPLOYMENT.md），本機請複製本檔案為 .env 並填值。
# 注意：.env 已在 .gitignore 中，請勿 commit 含實際值的 .env。

# ----- Database (本機與 Cloud Run 結構不同，見 DEPLOYMENT.md) -----
DATABASE_URL=

# ----- NextAuth -----
AUTH_SECRET=                # openssl rand -hex 32 產生
AUTH_TRUST_HOST=true
AUTH_URL=                   # 與 NEXTAUTH_URL 相同；NextAuth v5 兩個都認
NEXTAUTH_URL=               # 線上：https://timeoff.pacnexus.net；本機：http://localhost:3000

# ----- Google OAuth -----
AUTH_GOOGLE_ID=             # 從 GCP Console → APIs & Services → Credentials 拿
AUTH_GOOGLE_SECRET=

# ----- Brevo Email -----
MAIL_PROVIDER=brevo
MAIL_API_KEY=
FROM_EMAIL=
SENDER_NAME=

# ----- LINE Messaging API -----
LINE_CHANNEL_ID=            # LINE Developers Console
LINE_CHANNEL_SECRET=        # 用於 webhook 簽章驗證
LINE_CHANNEL_ACCESS_TOKEN=  # long-lived，用於推播（Reissue 會立即失效舊的）
LINE_BOT_BASIC_ID=          # 例 @abc1234d，用來組綁定 QR Code 連結

# ----- LINE LIFF（手機免 Google 登入）-----
NEXT_PUBLIC_LIFF_ID=        # LIFF app ID；client 端 liff.init 用（NEXT_PUBLIC_ 於 build 時 inline，需在建置環境設好）
LINE_LOGIN_CHANNEL_ID=      # 選填：LIFF 不在現有 Messaging channel 下時，填 LINE Login channel id（驗 idToken aud 用）；留空則用 LINE_CHANNEL_ID

# ----- Cron -----
CRON_SECRET=                # 隨機字串，保護 /api/cron/* 路由；openssl rand -hex 32
